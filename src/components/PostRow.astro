---
import CoverArt from "./CoverArt.astro";
import { formatDate, isoDate } from "@/i18n/format";
import { getMessages } from "@/i18n/ui";
import type { Post } from "@/lib/posts";

/**
 * 文章列表里的一行:左边是分类 / 日期 / 标题 / 摘要,右边是缩略封面,行与行之间只有一条细分隔线。
 * 首页「最近更新」和专题页用它:和卡片网格相比,任何篇数都排得齐(不会有空格 / 孤儿卡),标题和摘要一眼扫得完。
 */
interface Props {
  post: Post;
  headingLevel?: 2 | 3;
}
const { post, headingLevel = 3 } = Astro.props;
const m = getMessages(post.locale);
const H = `h${headingLevel}` as "h2" | "h3";
---

<article class="row">
  <div class="text">
    <p class="meta">
      <span class="cat">{m.categories[post.category].name}</span>
      <time datetime={isoDate(post.published)}>{formatDate(post.published, post.locale)}</time>
      <span class="read">{m.card.minRead(post.readingMinutes)}</span>
    </p>
    <H class="title"><a href={post.path}>{post.title}</a></H>
    <p class="desc">{post.description}</p>
  </div>
  <div class="thumb">
    {
      post.cover ? (
        <img src={post.cover} width="1200" height="630" alt="" loading="lazy" decoding="async" />
      ) : (
        <CoverArt category={post.category} iconSize={40} />
      )
    }
  </div>
</article>

<style>
  .row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 16rem;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding-block: 1.75rem;
    border-block-start: 1px solid var(--border);
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    min-inline-size: 0;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1rem;
    color: var(--text-muted);
    font-size: 0.85rem;
  }
  .cat {
    color: var(--link);
    font-weight: 700;
  }
  .title {
    font-size: 1.4rem;
    line-height: 1.3;
    font-weight: 750;
    letter-spacing: -0.015em;
  }
  .title a {
    color: var(--text);
    text-decoration: none;
  }
  .title a:hover {
    color: var(--link);
  }
  /* 整行都能点:把标题链接撑满整行 */
  .title a::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .row:has(a:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
  .title a:focus-visible {
    outline: none;
  }
  .desc {
    max-inline-size: 42rem;
    color: var(--text-muted);
    font-size: 0.98rem;
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .thumb {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-soft);
  }
  .thumb img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
  }
  .thumb :global(.cover) {
    aspect-ratio: 1200 / 630;
  }
  @media (max-width: 40rem) {
    .row {
      grid-template-columns: minmax(0, 1fr) 6.5rem;
      align-items: start;
      padding-block: 1.25rem;
    }
    .title {
      font-size: 1.12rem;
    }
    .desc {
      -webkit-line-clamp: 2;
      font-size: 0.92rem;
    }
  }
</style>
