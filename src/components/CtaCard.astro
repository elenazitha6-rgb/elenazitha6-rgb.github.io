---
import Icon from "./Icon.astro";
import InviteCoupon from "./InviteCoupon.astro";
import type { Locale } from "@/i18n/config";
import { getMessages } from "@/i18n/ui";
import { INVITE_CODE, brandNameFor, officialLink } from "@/site";

/**
 * 引向官网的推广卡,放在内容流里(文章末尾 / 首页 / 专题页 / 侧栏),不悬浮、不遮挡。
 * 版式参考 sulian-video 的站内推广卡:品牌头 → 产品优势(住宅 IP / 家宽 IP / 代理 IP / 透明网关,见 `cta.products`)→ 卖点(对勾)→ 邀请码优惠券(可一键复制)→ 一个主按钮直达注册页。
 * 产品优势是「卖什么」,三条福利是「为什么现在试」,两块都要有:只有福利会让读者不知道这个产品到底是什么(2026-11-26 用户指出)。
 * 卖点是三条福利(各语言用官网自己的说法,见 i18n/ui 的 `cta.features`):注册赠送 / 邀请好友双方各得 / 用邀请码注册再得。
 * 最后一条(用邀请码注册)加重,和下面的邀请码券、主按钮是同一件事。
 * 这是官方博客,推广的就是我们自己的产品,所以不做「广告」标注;关于页有利益说明。
 * `placement` 写进 utm_campaign,官网统计里能分辨是博客的哪个位置。
 * 主按钮是渐变底,但两端都压在第 7 / 8 档蓝上(白字 ≥ 4.9:1),不用 #0581fa 以上的亮蓝放文字。
 */
interface Props {
  locale: Locale;
  variant?: "banner" | "side";
  placement: string;
}
const { locale, variant = "banner", placement } = Astro.props;
const m = getMessages(locale);
const isBanner = variant === "banner";
const registerHref = officialLink(locale, "/register", placement, { invite: INVITE_CODE });
const pricingHref = officialLink(locale, "/pricing", placement);
// 产品优势四项的图标,顺序和 i18n 的 `cta.products` 一一对应:住宅 IP / 家宽 IP / 代理 IP / 透明网关
const PRODUCT_ICONS = ["home", "broadband", "proxies", "gateway"] as const;
const products = m.cta.products.map((p, i) => ({ ...p, icon: PRODUCT_ICONS[i] ?? "home" }));
// 侧栏里产品名排成 2×2,每格只有约 6rem 宽;俄文的「Резидентный IP」「HTTP/SOCKS5-прокси」是长单词,日文的「ネットワークゲートウェイ」
// 「HTTP/SOCKS5プロキシ」是长词组,波斯文的「پروکسی HTTP/SOCKS5」会折成三行,英文的「ISP residential IP」也折三行,放不下会很难看。
// 实测(2026-11-26,1440 宽)只有中文 / 繁体(每项一行)和土耳其文(最多两行)适合 2×2,其它语言排成一列,高度反而不比折行的 2×2 高
const gridProducts = locale === "zh" || locale === "zh-Hant" || locale === "tr";
const stackProducts = !gridProducts;
---

<aside class:list={["cta", variant]}>
  {
    isBanner ? (
      <>
        <div class="lead">
          <div class="head">
            <img src="/brand/logo-64.webp" srcset="/brand/logo-64.webp 1x, /brand/logo-96.webp 2x" width="44" height="44" alt="" decoding="async" />
            <p class="name">{brandNameFor(locale)}</p>
            <h2 class="tagline">{m.cta.title}</h2>
          </div>
          <ul class="products" role="list" aria-label={m.cta.productsLabel}>
            {products.map((p) => (
              <li>
                <span class="pi"><Icon name={p.icon} size={17} /></span>
                <span class="pn">
                  <strong>{p.name}</strong>
                  <span>{p.text}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
        <div class="body">
          <ul class="perks" role="list">
            {m.cta.features.map((f) => (
              <li>
                <span class="check"><Icon name="check" size={13} strokeWidth={3} /></span>
                <span class="pc">
                  <strong>{f.title}</strong>
                  <span class="pt">{f.text}</span>
                </span>
              </li>
            ))}
          </ul>
          <InviteCoupon locale={locale} />
          <div class="actions">
            <a class="cta-btn" href={registerHref} rel="noopener" data-copy-code={INVITE_CODE}>
              <span>{m.cta.primary}</span>
              <Icon name="arrow" size={18} strokeWidth={2.4} class="arrow" />
            </a>
            <a class="btn btn-secondary" href={pricingHref} rel="noopener">{m.cta.secondary}</a>
          </div>
        </div>
      </>
    ) : (
      <>
        <div class="head">
          <img src="/brand/logo-64.webp" srcset="/brand/logo-64.webp 1x, /brand/logo-96.webp 2x" width="44" height="44" alt="" decoding="async" />
          <p class="name">{brandNameFor(locale)}</p>
          <p class="tagline">{m.cta.sideSubtitle}</p>
        </div>
        <ul class:list={["products", { stack: stackProducts }]} role="list" aria-label={m.cta.productsLabel}>
          {products.map((p) => (
            <li>
              <span class="pi"><Icon name={p.icon} size={16} /></span>
              <span class="pn"><strong>{p.name}</strong></span>
            </li>
          ))}
        </ul>
        <ul class="perks" role="list">
          {m.cta.features.map((f) => (
            <li>
              <span class="check"><Icon name="check" size={13} strokeWidth={3} /></span>
              <span class="pc"><strong>{f.title}</strong></span>
            </li>
          ))}
        </ul>
        <InviteCoupon locale={locale} />
        <a class="cta-btn" href={registerHref} rel="noopener" data-copy-code={INVITE_CODE}>
          <span>{m.cta.primary}</span>
          <Icon name="arrow" size={18} strokeWidth={2.4} class="arrow" />
        </a>
      </>
    )
  }
</aside>

<style>
  .cta {
    position: relative;
    display: grid;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--accent-soft) 0%, var(--surface) 62%);
    box-shadow: var(--shadow-sm), 0 10px 28px -12px rgb(5 129 250 / 0.3);
  }
  .cta::before {
    content: "";
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: 4px;
    background: var(--gradient);
  }

  /* 头部:Logo + 品牌名一行,副标题 / 标题单独占整行 */
  .head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    column-gap: 0.75rem;
    row-gap: 0.7rem;
    min-inline-size: 0;
  }
  .head img {
    grid-column: 1;
    grid-row: 1;
    display: block;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: 0.7rem;
    box-shadow: 0 4px 14px rgb(5 129 250 / 0.28);
  }
  .name {
    grid-column: 2;
    grid-row: 1;
    margin: 0;
    color: var(--text);
    font-size: 1.3rem;
    font-weight: 850;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }
  .tagline {
    grid-column: 1 / -1;
    grid-row: 2;
    margin: 0;
    padding-block-start: 0.7rem;
    border-block-start: 1px solid color-mix(in srgb, var(--accent) 16%, transparent);
    color: var(--text-muted);
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.45;
    text-wrap: balance;
  }

  /* 产品优势:住宅 IP / 家宽 IP / 代理 IP / 透明网关四行,浅蓝底板 + 方形图标,和下面的对勾福利区分开 */
  .products {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0.8rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--accent) 16%, transparent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--accent) 6%, var(--surface));
    list-style: none;
  }
  .products li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    min-inline-size: 0;
  }
  .pi {
    flex: none;
    display: grid;
    place-items: center;
    inline-size: 1.9rem;
    block-size: 1.9rem;
    border-radius: 0.55rem;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--link);
  }
  .pn {
    display: grid;
    gap: 0.05rem;
    min-inline-size: 0;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  .pn strong {
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 750;
  }
  .pn span {
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  /* 卖点:对勾放进浅蓝圆底,最后一条(用邀请码注册)加重 */
  .perks {
    display: grid;
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .perks li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    color: var(--text);
    line-height: 1.45;
  }
  .check {
    flex: none;
    display: grid;
    place-items: center;
    inline-size: 1.4rem;
    block-size: 1.4rem;
    margin-block-start: 0.05rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--link);
  }
  .pc {
    display: grid;
    gap: 0.15rem;
    min-inline-size: 0;
  }
  .pc strong {
    font-size: 0.92rem;
    font-weight: 650;
  }
  .perks li:last-child .pc strong {
    color: var(--link);
    font-weight: 800;
  }
  .pt {
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  /* 主按钮:通栏胶囊 + 箭头 + 蓝色光晕,直达官网注册页(链接已带邀请码) */
  .cta-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-block-size: 48px;
    padding: 0.75rem 1.1rem;
    border-radius: 999px;
    background: linear-gradient(100deg, var(--brand-800) 0%, var(--brand-700) 100%);
    box-shadow: 0 12px 28px -10px rgb(6 112 214 / 0.75);
    color: #fff;
    font-size: 0.95rem;
    font-weight: 800;
    line-height: 1.3;
    text-align: center;
    text-decoration: none;
    text-wrap: balance;
    transition: filter 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  .cta-btn:hover {
    color: #fff;
    filter: brightness(1.08);
  }
  .cta-btn:focus-visible {
    outline: 3px solid rgb(5 129 250 / 0.4);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .cta-btn:hover {
      transform: translateY(-1px);
    }
    .cta-btn:active {
      transform: translateY(1px);
    }
  }
  html[data-theme="dark"] .cta-btn {
    background: linear-gradient(100deg, #2f97fb 0%, #62b0fc 100%);
    box-shadow: 0 12px 28px -10px rgb(47 151 251 / 0.6);
    color: #04111f;
  }
  html[data-theme="dark"] .cta-btn:hover {
    color: #04111f;
  }

  /* 侧栏竖版(约 17rem 宽):右栏是 sticky 的,卡片太高会把下面的目录挤出一屏,所以产品优势只留名称,排成 2×2,说明放在文末横版卡里 */
  .side {
    gap: 0.95rem;
    padding: 1.35rem 1.15rem 1.15rem;
  }
  .side .products {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem 0.5rem;
    padding: 0.65rem 0.7rem;
  }
  .side .products.stack {
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem;
  }
  .side .products li {
    align-items: center;
    gap: 0.45rem;
  }
  .side .pi {
    inline-size: 1.65rem;
    block-size: 1.65rem;
    border-radius: 0.5rem;
  }
  .side .pn strong {
    font-size: 0.8rem;
    line-height: 1.25;
  }

  /* 文末 / 首页 / 专题页横版:左边品牌 + 邀请码,右边卖点 + 按钮;窄屏叠成竖版 */
  .banner {
    grid-template-columns: minmax(16rem, 0.9fr) minmax(0, 1.25fr);
    align-items: center;
    gap: 1.5rem 2.5rem;
    margin-block: 3rem 0;
    padding: 2rem 2.25rem;
  }
  .lead,
  .body {
    display: grid;
    gap: 1.25rem;
    min-inline-size: 0;
  }
  .banner .tagline {
    color: var(--text);
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  /* 两个按钮都可伸展:右列够宽就并排填满一行,不够宽换行时各自撑满整行(次按钮不能缩在左边) */
  .actions .btn {
    flex: 1 1 auto;
  }
  .actions .cta-btn {
    flex: 1 1 14rem;
  }
  @media (max-width: 760px) {
    .banner {
      grid-template-columns: minmax(0, 1fr);
      padding: 1.5rem 1.25rem;
    }
    .actions .btn {
      flex: 1 1 100%;
    }
  }
</style>

<script>
  // 点主按钮时顺手把邀请码写进剪贴板:链接里的 ?invite= 在官网注册页会自动填,但读者可能转去客户端 / App 里注册,
  // 那时 URL 上下文丢了,剪贴板里的码就是兜底(粘贴即可)。
  // 普通左键点击:等剪贴板写完(最多 400ms,权限弹窗卡住也不拦跳转)再跳;Ctrl / Cmd / Shift / 中键等保持浏览器默认行为,只尽力复制。
  document.addEventListener("click", (e) => {
    const link = (e.target as Element | null)?.closest<HTMLAnchorElement>("a[data-copy-code]");
    if (!link) return;
    let copied: Promise<unknown> | undefined;
    try {
      copied = navigator.clipboard?.writeText(link.dataset.copyCode ?? "").catch(() => {});
    } catch {}
    const plain = e.button === 0 && !e.metaKey && !e.ctrlKey && !e.shiftKey && !e.altKey;
    if (!copied || !plain || e.defaultPrevented) return;
    e.preventDefault();
    const href = link.href;
    Promise.race([copied, new Promise((r) => setTimeout(r, 400))]).then(() => location.assign(href));
  });
</script>
