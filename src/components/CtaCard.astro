---
import Icon from "./Icon.astro";
import type { IconName } from "./Icon.astro";
import type { Locale } from "@/i18n/config";
import { getMessages } from "@/i18n/ui";
import { brandNameFor, officialLink } from "@/site";

/**
 * 引向官网的推广卡,放在内容流里(文章末尾 / 首页 / 专题页 / 侧栏),不悬浮、不遮挡。
 * 卖点是官网下载页的四条(各语言用官网自己的说法,见 i18n/ui 的 `cta.features`):
 * 赠送流量 / AI 专线优化 / 打开即用 / 四类连接方式。
 * 这是官方博客,推广的就是我们自己的产品,所以不做「广告」标注;关于页有利益说明。
 * `placement` 写进 utm_campaign,官网统计里能分辨是博客的哪个位置。
 */
interface Props {
  locale: Locale;
  variant?: "banner" | "side";
  placement: string;
}
const { locale, variant = "banner", placement } = Astro.props;
const m = getMessages(locale);
// 和 features 的顺序一一对应:赠送 / AI 专线优化 / 打开即用 / 四类连接方式
const ICONS: IconName[] = ["gift", "ai", "bolt", "layers"];
const features = m.cta.features.map((f, i) => ({ ...f, icon: ICONS[i] ?? "check" }));
---

{
  variant === "banner" ? (
    <aside class="cta banner">
      <div class="head">
        <p class="brand ">
          <img src="/brand/logo-64.webp" srcset="/brand/logo-64.webp 1x, /brand/logo-96.webp 2x" width="40" height="40" alt="" decoding="async" />
          <span>{brandNameFor(locale)}</span>
        </p>
        <h2>{m.cta.title}</h2>
      </div>
      <ul class="features" role="list">
        {
          features.map((f) => (
            <li>
              <span class="icon"><Icon name={f.icon} size={22} strokeWidth={1.8} /></span>
              <span class="copy">
                <strong>{f.title}</strong>
                <span>{f.text}</span>
              </span>
            </li>
          ))
        }
      </ul>
      <div class="actions">
        <a class="btn btn-primary" href={officialLink(locale, "/download", placement)} rel="noopener">
          {m.cta.primary}
          <Icon name="arrow" size={18} class="arrow" />
        </a>
        <a class="btn btn-secondary" href={officialLink(locale, "/pricing", placement)} rel="noopener">{m.cta.secondary}</a>
      </div>
    </aside>
  ) : (
    <aside class="cta side">
      <p class="brand sm">
        <img src="/brand/logo-64.webp" srcset="/brand/logo-64.webp 1x, /brand/logo-96.webp 2x" width="32" height="32" alt="" decoding="async" />
        <span>{brandNameFor(locale)}</span>
      </p>
      <p class="side-title">{m.cta.sideTitle}</p>
      <ul class="side-list" role="list">
        {
          features.map((f) => (
            <li>
              <span class="icon sm"><Icon name={f.icon} size={16} strokeWidth={2} /></span>
              <span>{f.title}</span>
            </li>
          ))
        }
      </ul>
      <a class="btn btn-primary" href={officialLink(locale, "/download", placement)} rel="noopener">{m.cta.primary}</a>
    </aside>
  )
}

<style>
  .cta {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--accent-soft-border);
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--accent-soft), var(--surface) 70%);
  }
  .cta::before {
    content: "";
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: 4px;
    background: var(--gradient);
  }
  /* 品牌标识:Logo + 品牌名,卡片一眼认得出是谁家的 */
  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--text);
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .brand img {
    flex: none;
    display: block;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: 0.6rem;
  }
  .brand.sm {
    gap: 0.55rem;
    font-size: 0.98rem;
  }
  .brand.sm img {
    inline-size: 2rem;
    block-size: 2rem;
    border-radius: 0.5rem;
  }
  .icon {
    flex: none;
    display: grid;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    border-radius: 12px;
    background: var(--surface);
    border: 1px solid var(--accent-soft-border);
    color: var(--link);
    box-shadow: var(--shadow-sm);
  }
  .icon.sm {
    inline-size: 28px;
    block-size: 28px;
    border-radius: 8px;
  }

  .banner {
    display: grid;
    gap: 1.5rem;
    padding: 2rem 2.25rem;
    margin-block: 3rem 0;
  }
  .banner h2 {
    margin-block-start: 0.3rem;
    color: var(--text);
    font-size: 1.6rem;
    font-weight: 800;
  }
  .features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .features li {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
  }
  .copy {
    display: grid;
    gap: 0.15rem;
    min-inline-size: 0;
  }
  .copy strong {
    color: var(--text);
    font-size: 1rem;
    font-weight: 750;
    line-height: 1.35;
  }
  .copy span {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .side {
    display: grid;
    gap: 0.75rem;
    padding: 1.4rem 1.3rem 1.3rem;
  }
  .side-title {
    color: var(--text);
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.3;
  }
  .side-list {
    display: grid;
    gap: 0.6rem;
    margin: 0.2rem 0 0.4rem;
    padding: 0;
    list-style: none;
  }
  .side-list li {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    color: var(--text-soft);
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.35;
  }
  @media (max-width: 720px) {
    .banner {
      padding: 1.5rem 1.25rem;
    }
    .features {
      grid-template-columns: 1fr;
    }
    .actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
