---
import CoverArt from "./CoverArt.astro";
import Icon from "./Icon.astro";
import { formatDate, isoDate } from "@/i18n/format";
import { getMessages } from "@/i18n/ui";
import type { Post } from "@/lib/posts";

interface Props {
  post: Post;
  /**
   * featured:首页顶部通栏大卡(左图右文),只有一篇文章时用;
   * lead:三列网格里跨两列的头条卡(左图右文,字号收一档);默认是竖排小卡。
   */
  variant?: "default" | "featured" | "lead";
  headingLevel?: 2 | 3;
  /** 头条卡上的小标签(如「编辑推荐」)。 */
  badge?: string;
}
const { post, variant = "default", headingLevel = 3, badge } = Astro.props;
const m = getMessages(post.locale);
const H = `h${headingLevel}` as "h2" | "h3";
---

<article class:list={["card", variant]}>
  <div class="media">
    {
      post.cover ? (
        <img src={post.cover} width="1200" height="630" alt="" loading={variant === "default" ? "lazy" : "eager"} decoding="async" />
      ) : (
        <CoverArt category={post.category} iconSize={variant === "default" ? 48 : 72} />
      )
    }
  </div>
  <div class="body">
    {badge && <span class="badge">{badge}</span>}
    <p class="meta">
      <span class="cat">{m.categories[post.category].name}</span>
      <span aria-hidden="true">·</span>
      <time datetime={isoDate(post.published)}>{formatDate(post.published, post.locale)}</time>
    </p>
    <H class="title"><a href={post.path}>{post.title}</a></H>
    <p class="desc">{post.description}</p>
    <p class="foot">
      <span class="read"><Icon name="clock" size={15} />{m.card.minRead(post.readingMinutes)}</span>
      <span class="go" aria-hidden="true"><Icon name="arrow" size={18} class="arrow" /></span>
    </p>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.2s, border-color 0.2s, transform 0.2s;
  }
  .card:hover {
    border-color: var(--accent-soft-border);
    box-shadow: var(--shadow-md);
  }
  @media (prefers-reduced-motion: no-preference) {
    .card:hover {
      transform: translateY(-2px);
    }
  }
  .card:has(a:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
    padding: 1.25rem 1.35rem 1.2rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    color: var(--text-muted);
    font-size: 0.82rem;
  }
  .cat {
    color: var(--link);
    font-weight: 700;
  }
  .title {
    font-size: 1.2rem;
    line-height: 1.3;
    font-weight: 800;
  }
  .title a {
    color: var(--text);
    text-decoration: none;
  }
  /* 整张卡片都能点:把标题链接撑满整个卡片 */
  .title a::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .title a:focus-visible {
    outline: none;
  }
  .desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-block-start: auto;
    padding-block-start: 0.4rem;
    color: var(--text-muted);
    font-size: 0.85rem;
  }
  .read {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .go {
    color: var(--link);
    transition: transform 0.2s;
  }
  .card:hover .go {
    transform: translateX(3px);
  }
  [dir="rtl"] .card:hover .go {
    transform: translateX(-3px);
  }

  .badge {
    align-self: flex-start;
    padding: 0.15rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--accent-soft-border);
    background: var(--accent-soft);
    color: var(--link);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .featured,
  .lead {
    flex-direction: row;
  }
  /* 头条平铺在页面上(不是带边框的卡片):大图加细边,文字直接放在白底上,和下面的文章行形成层次 */
  .featured {
    align-items: center;
    gap: clamp(1.5rem, 3.5vw, 3rem);
    overflow: visible;
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }
  .featured:hover {
    border-color: transparent;
    box-shadow: none;
    transform: none;
  }
  .featured .media {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  /* 52% 宽正好接近封面 1200:630 的比例,首页大卡里封面几乎不被裁掉 */
  .featured .media {
    flex: 0 0 56%;
    display: flex;
  }
  .lead .media {
    flex: 0 0 52%;
    display: flex;
  }
  .media img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
  }
  .featured .media :global(.cover),
  .lead .media :global(.cover) {
    aspect-ratio: auto;
    min-block-size: 100%;
  }
  .featured .media img,
  .lead .media img {
    block-size: 100%;
    aspect-ratio: auto;
    min-block-size: 100%;
  }
  .featured .body {
    flex: 1 1 0;
    justify-content: center;
    gap: 0.9rem;
    padding: 0;
  }
  .featured .title {
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  .featured .desc {
    font-size: 1.05rem;
    -webkit-line-clamp: 4;
  }
  /* 跨两列的头条卡:宽度只有通栏的一半多,字号和内边距收一档,文字不挤 */
  .lead .body {
    justify-content: center;
    gap: 0.75rem;
    padding: 1.5rem 1.6rem;
  }
  .lead .title {
    font-size: 1.45rem;
    letter-spacing: -0.015em;
  }
  .lead .desc {
    font-size: 0.98rem;
    -webkit-line-clamp: 4;
  }
  @media (max-width: 820px) {
    .featured,
    .lead {
      flex-direction: column;
    }
    .featured .media,
    .lead .media {
      flex: none;
    }
    .featured .media :global(.cover),
    .lead .media :global(.cover) {
      aspect-ratio: 16 / 9;
      min-block-size: 0;
    }
    .featured .media img,
    .lead .media img {
      block-size: auto;
      aspect-ratio: 1200 / 630;
      min-block-size: 0;
    }
    .featured .body {
      padding: 1.1rem 0 0;
    }
    .lead .body {
      padding: 1.25rem 1.35rem 1.2rem;
    }
    .featured .title,
    .lead .title {
      font-size: 1.45rem;
    }
  }
</style>
