---
import CoverArt from "./CoverArt.astro";
import Icon from "./Icon.astro";
import { formatDate, isoDate } from "@/i18n/format";
import { getMessages } from "@/i18n/ui";
import type { Post } from "@/lib/posts";

interface Props {
  post: Post;
  /** featured:首页顶部的大卡(左图右文);默认是竖排小卡。 */
  variant?: "default" | "featured";
  headingLevel?: 2 | 3;
}
const { post, variant = "default", headingLevel = 3 } = Astro.props;
const m = getMessages(post.locale);
const H = `h${headingLevel}` as "h2" | "h3";
---

<article class:list={["card", variant]}>
  <div class="media">
    <CoverArt category={post.category} iconSize={variant === "featured" ? 72 : 48} />
  </div>
  <div class="body">
    <p class="meta">
      <span class="cat">{m.categories[post.category].name}</span>
      <span aria-hidden="true">·</span>
      <time datetime={isoDate(post.published)}>{formatDate(post.published, post.locale)}</time>
    </p>
    <H class="title"><a href={post.path}>{post.title}</a></H>
    <p class="desc">{post.description}</p>
    <p class="foot">
      <span class="read"><Icon name="clock" size={15} />{m.card.minRead(post.readingMinutes)}</span>
      <span class="go" aria-hidden="true"><Icon name="arrow" size={18} class="arrow" /></span>
    </p>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.2s, border-color 0.2s, transform 0.2s;
  }
  .card:hover {
    border-color: var(--accent-soft-border);
    box-shadow: var(--shadow-md);
  }
  @media (prefers-reduced-motion: no-preference) {
    .card:hover {
      transform: translateY(-2px);
    }
  }
  .card:focus-within {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
    padding: 1.25rem 1.35rem 1.2rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    color: var(--text-muted);
    font-size: 0.82rem;
  }
  .cat {
    color: var(--link);
    font-weight: 700;
  }
  .title {
    font-size: 1.2rem;
    line-height: 1.3;
    font-weight: 800;
  }
  .title a {
    color: var(--text);
    text-decoration: none;
  }
  /* 整张卡片都能点:把标题链接撑满整个卡片 */
  .title a::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .title a:focus-visible {
    outline: none;
  }
  .desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-block-start: auto;
    padding-block-start: 0.4rem;
    color: var(--text-muted);
    font-size: 0.85rem;
  }
  .read {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .go {
    color: var(--link);
    transition: transform 0.2s;
  }
  .card:hover .go {
    transform: translateX(3px);
  }
  [dir="rtl"] .card:hover .go {
    transform: translateX(-3px);
  }

  .featured {
    flex-direction: row;
  }
  .featured .media {
    flex: 0 0 46%;
    display: flex;
  }
  .featured .media :global(.cover) {
    aspect-ratio: auto;
    min-block-size: 100%;
  }
  .featured .body {
    justify-content: center;
    gap: 0.9rem;
    padding: 2rem 2.25rem;
  }
  .featured .title {
    font-size: 1.85rem;
    letter-spacing: -0.02em;
  }
  .featured .desc {
    font-size: 1.05rem;
    -webkit-line-clamp: 4;
  }
  @media (max-width: 820px) {
    .featured {
      flex-direction: column;
    }
    .featured .media {
      flex: none;
    }
    .featured .media :global(.cover) {
      aspect-ratio: 16 / 9;
      min-block-size: 0;
    }
    .featured .body {
      padding: 1.25rem 1.35rem 1.2rem;
    }
    .featured .title {
      font-size: 1.45rem;
    }
  }
</style>
