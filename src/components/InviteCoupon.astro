---
import Icon from "./Icon.astro";
import type { Locale } from "@/i18n/config";
import { getMessages } from "@/i18n/ui";
import { INVITE_CODE } from "@/site";

/**
 * 推广卡里的邀请码「优惠券」:标签 / 大号邀请码 / 奖励说明各占一行,右侧一键复制。
 * 奖励数字以官网 /invite 页为准(见 src/site.ts 的 INVITE_CODE 注释),文案在 i18n 的 `cta.inviteHint`。
 */
interface Props {
  locale: Locale;
}
const m = getMessages(Astro.props.locale);
---

<div class="coupon">
  <span class="gift"><Icon name="gift" size={20} strokeWidth={2} /></span>
  <p class="text">
    <span class="label">{m.cta.inviteLabel}</span>
    <code class="code" dir="ltr">{INVITE_CODE}</code>
    <span class="reward">{m.cta.inviteHint}</span>
  </p>
  <button
    type="button"
    class="copy-btn"
    data-copy={INVITE_CODE}
    data-label={m.cta.copyCode}
    data-done={m.cta.codeCopied}
    aria-label={m.cta.copyCode}
    title={m.cta.copyCode}
  >
    <span class="i-copy"><Icon name="copy" size={17} strokeWidth={2} /></span>
    <span class="i-done"><Icon name="check" size={17} strokeWidth={2.6} /></span>
  </button>
</div>

<style>
  .coupon {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-inline-size: 0;
    padding: 0.7rem 0.75rem;
    border: 1.5px dashed color-mix(in srgb, var(--accent) 42%, transparent);
    border-radius: 0.9rem;
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 9%, transparent), rgb(11 193 206 / 0.06));
  }
  .gift {
    flex: none;
    display: inline-flex;
    padding: 0.45rem;
    border-radius: 0.65rem;
    background: var(--surface);
    color: var(--link);
    box-shadow: 0 1px 3px rgb(5 129 250 / 0.2);
  }
  .text {
    flex: 1;
    display: grid;
    gap: 1px;
    min-inline-size: 0;
    margin: 0;
  }
  .label {
    color: var(--text-muted);
    font-size: 0.76rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .code {
    padding: 0;
    background: none;
    color: var(--link);
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    line-height: 1.3;
    overflow-wrap: anywhere;
    user-select: all;
  }
  .reward {
    color: var(--text-soft);
    font-size: 0.76rem;
    line-height: 1.4;
    text-wrap: balance;
  }
  .copy-btn {
    flex: none;
    display: grid;
    place-items: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    border: 1px solid var(--accent-soft-border);
    border-radius: 0.65rem;
    background: var(--surface);
    color: var(--link);
    cursor: pointer;
    transition: background-color 0.15s, border-color 0.15s, color 0.15s;
  }
  .copy-btn:hover {
    background: var(--accent-soft);
  }
  .copy-btn:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .i-done {
    display: none;
  }
  .copy-btn[data-copied] {
    border-color: transparent;
    background: #0b8a6a;
    color: #fff;
  }
  .copy-btn[data-copied] .i-copy {
    display: none;
  }
  .copy-btn[data-copied] .i-done {
    display: inline-flex;
  }
  .i-copy,
  .i-done {
    line-height: 0;
  }
  html[data-theme="dark"] .copy-btn[data-copied] {
    background: #34d399;
    color: #04111f;
  }
</style>

<script>
  // 复制邀请码:点按钮写入剪贴板,按钮变成绿色对勾 2 秒并更新读屏标签;不支持剪贴板时静默不处理(码本身就显示在旁边,也可整段选中)
  const timers = new WeakMap<HTMLButtonElement, number>();
  document.addEventListener("click", async (e) => {
    const btn = (e.target as Element | null)?.closest<HTMLButtonElement>("[data-copy]");
    if (!btn) return;
    try {
      await navigator.clipboard.writeText(btn.dataset.copy ?? "");
    } catch {
      return;
    }
    const done = btn.dataset.done ?? "";
    const label = btn.dataset.label ?? "";
    btn.toggleAttribute("data-copied", true);
    btn.title = done;
    btn.setAttribute("aria-label", done);
    clearTimeout(timers.get(btn));
    timers.set(
      btn,
      window.setTimeout(() => {
        btn.toggleAttribute("data-copied", false);
        btn.title = label;
        btn.setAttribute("aria-label", label);
      }, 2000),
    );
  });
</script>
