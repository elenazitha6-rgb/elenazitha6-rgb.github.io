---
/**
 * 文章内嵌 FAQ。用原生 <details>,没有 JS 也能展开,折叠的答案也在 HTML 里(搜索引擎和 AI 都读得到)。
 * 页面上的问答和 FAQPage 结构化数据是同一份数据(文章 frontmatter 的 faq),必须逐字一致。
 */
interface Props {
  items: { q: string; a: string }[];
  title: string;
}
const { items, title } = Astro.props;
---

<section class="faq" aria-labelledby="faq-title">
  <h2 id="faq-title">{title}</h2>
  <div class="list">
    {
      items.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq {
    margin-block-start: 3.2rem;
  }
  h2 {
    color: var(--text);
    font-size: 1.6rem;
    font-weight: 800;
    margin-block-end: 1.1rem;
  }
  .list {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface);
  }
  details + details {
    border-block-start: 1px solid var(--border);
  }
  summary {
    position: relative;
    display: block;
    padding: 1.05rem 3rem 1.05rem 1.25rem;
    color: var(--text);
    font-weight: 700;
    font-size: 1.02rem;
    line-height: 1.45;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    background: var(--bg-soft);
  }
  /* 展开 / 收起的加减号,用伪元素画,不占读屏 */
  summary::before,
  summary::after {
    content: "";
    position: absolute;
    inset-block-start: 50%;
    inset-inline-end: 1.25rem;
    inline-size: 0.8rem;
    block-size: 2px;
    margin-block-start: -1px;
    background: var(--brand-600);
    border-radius: 2px;
    transition: transform 0.2s;
  }
  summary::after {
    transform: rotate(90deg);
  }
  details[open] summary::after {
    transform: rotate(0deg);
  }
  [dir="rtl"] summary {
    padding: 1.05rem 1.25rem 1.05rem 3rem;
  }
  details p {
    padding: 0 1.25rem 1.2rem;
    color: var(--text-muted);
    line-height: 1.75;
    max-inline-size: 62ch;
  }
</style>
