---
import type { GetStaticPaths } from "astro";
import CtaCard from "@/components/CtaCard.astro";
import PostCard from "@/components/PostCard.astro";
import PostRow from "@/components/PostRow.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { CATEGORIES } from "@/categories";
import type { Locale } from "@/i18n/config";
import { langParam } from "@/i18n/paths";
import { getMessages } from "@/i18n/ui";
import { countByCategory, getContentLocales, getPosts, topicPath } from "@/lib/posts";
import { blogNode, graph, organizationNode, websiteNode } from "@/lib/schema";

export const getStaticPaths = (async () => {
  const locales = await getContentLocales();
  return locales.map((locale) => ({ params: { lang: langParam(locale) }, props: { locale } }));
}) satisfies GetStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const m = getMessages(locale);
const posts = await getPosts(locale);
const counts = countByCategory(posts);
// posts 为空时下面走「暂无文章」分支,不会用到 headline
// 头条永远是最新发布的一篇(posts 已按发布时间从新到旧排好),不看 featured 标记;
// featured 只决定头条卡片上有没有「编辑推荐」徽标(2026-11-24 用户要求「要显示最新的」)
const headline = posts[0]!;
// 文章是定时发布的,首页会从 1 篇慢慢长到 N 篇:头条一篇放大,其余排成一列「标题 + 摘要 + 缩略图」的行,任何篇数都排得齐
const rest = posts.slice(1);
const site = Astro.site!;
---

<BaseLayout
  locale={locale}
  title={m.home.metaTitle}
  description={m.home.metaDescription}
  path="/"
  active="articles"
  jsonLd={[graph([organizationNode(site, locale), websiteNode(site, locale), blogNode(site, locale, posts)])]}
>
  {/* 宽屏(≥1160px)时首页是两栏:左边 标题 / 主题 / 头条,右边是竖版推广卡,和文章页的右栏同一套结构,
      页头右侧那块空白就不浪费了,推广卡第一屏就能看到;窄屏退回单栏,横版推广卡放在头条下面。 */}
  <div class:list={["container", "top", { "has-side": posts.length > 0 }]}>
    <div class="top-main">
      <header class="masthead">
        <h1>{m.home.title}</h1>
        <p class="lead">{m.home.lead}</p>
      </header>

      {
        posts.length === 0 ? (
          <p class="empty">{m.home.empty}</p>
        ) : (
          <>
            <nav class="tabs" aria-label={m.home.topics}>
              <ul role="list">
                {
                  CATEGORIES.filter((c) => counts.has(c)).map((c) => (
                    <li>
                      <a href={topicPath(locale, c)}>
                        {m.categories[c].name}
                        <span class="count">{counts.get(c)}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </nav>

            <section class="feature" id="latest" aria-label={headline.featured ? m.home.featured : m.home.latest}>
              <PostCard post={headline} variant="featured" badge={headline.featured ? m.home.featured : undefined} headingLevel={2} />
            </section>
          </>
        )
      }
    </div>

    {
      posts.length > 0 && (
        <div class="top-side">
          <CtaCard locale={locale} variant="side" placement="home_side" />
        </div>
      )
    }
  </div>

  {
    posts.length > 0 && (
      <>
        {/* 窄屏的推广卡:放在头条下面、文章列表上面,第二屏就能看到,不用滚到页尾。仍在内容流里,不悬浮、不遮挡。宽屏有右栏那张,这张不显示。 */}
        <div class="container cta">
          <CtaCard locale={locale} placement="home_banner" />
        </div>

        {
          rest.length > 0 && (
            <section class="container list" aria-labelledby="list-title">
              <h2 id="list-title" class="list-title">{m.home.latest}</h2>
              <div class="rows">
                {rest.map((p) => <PostRow post={p} headingLevel={3} />)}
              </div>
            </section>
          )
        }
      </>
    )
  }
</BaseLayout>

<style>
  .top-main {
    min-inline-size: 0;
  }
  /* 右栏默认不显示(窄屏用下面的横版卡);≥1160px 时容器已是满宽 1120px,左栏 776px、右栏 18rem(和文章页右栏同宽) */
  .top-side {
    display: none;
  }
  @media (min-width: 1160px) {
    .top.has-side {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 18rem;
      column-gap: 3.5rem;
    }
    .top-side {
      display: block;
      align-self: start;
      /* 卡片顶边和标题顶边对齐:等于 .masthead 的上内边距 */
      padding-block-start: clamp(2.5rem, 6vw, 4.25rem);
    }
    .cta {
      display: none;
    }
  }
  .masthead {
    padding-block: clamp(2.5rem, 6vw, 4.25rem) 1.75rem;
  }
  h1 {
    max-inline-size: 44rem;
    text-wrap: balance;
    color: var(--text);
    font-size: clamp(1.9rem, 4.2vw, 2.85rem);
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.025em;
  }
  .lead {
    max-inline-size: 38rem;
    text-wrap: pretty;
    margin-block-start: 1rem;
    color: var(--text-muted);
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.7;
  }
  .empty {
    padding-block: 3rem;
    color: var(--text-muted);
  }

  /* 主题:一排文字标签,当前所在栏目一目了然,不做成胶囊按钮 */
  .tabs {
    border-block-end: 1px solid var(--border);
  }
  .tabs ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tabs a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding-block: 0.8rem;
    border-block-end: 2px solid transparent;
    margin-block-end: -1px;
    color: var(--text-soft);
    font-size: 0.95rem;
    font-weight: 650;
    text-decoration: none;
  }
  .tabs a:hover {
    color: var(--link);
    border-block-end-color: var(--accent-soft-border);
  }
  .count {
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 500;
  }

  .feature {
    padding-block-start: 2.5rem;
  }
  .list {
    padding-block-start: 3.25rem;
  }
  .list-title {
    margin-block-end: 0.9rem;
    color: var(--text);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .rows {
    border-block-end: 1px solid var(--border);
  }
  /* 推广卡自己有 3rem 的上外边距,和头条卡之间的间距由它负责 */
  .cta {
    padding-block-start: 0;
  }
</style>
