---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CoverArt from "@/components/CoverArt.astro";
import CtaCard from "@/components/CtaCard.astro";
import FaqList from "@/components/FaqList.astro";
import Icon from "@/components/Icon.astro";
import PostCard from "@/components/PostCard.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDate, isoDate } from "@/i18n/format";
import { langParam, localePath } from "@/i18n/paths";
import { getMessages } from "@/i18n/ui";
import { getAllPosts, getPosts, getTranslationLocales, relatedPosts, topicPath, type Post } from "@/lib/posts";
import { blogPostingNode, breadcrumbNode, definedTermNode, faqNode, graph } from "@/lib/schema";
import { pageTitle } from "@/site";

export const getStaticPaths = (async () => {
  const all = await getAllPosts();
  return all.map((post) => ({ params: { lang: langParam(post.locale), slug: post.slug }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props as { post: Post };
const locale = post.locale;
const m = getMessages(locale);
const site = Astro.site!;

const { Content, headings } = await render(post.entry);
const siblings = await getPosts(locale);
const alternates = await getTranslationLocales(post.slug);
const index = siblings.findIndex((p) => p.slug === post.slug);
const newer = index > 0 ? siblings[index - 1] : undefined;
const older = index >= 0 ? siblings[index + 1] : undefined;
const related = relatedPosts(post, siblings);
const categoryName = m.categories[post.category].name;

const crumbs = [
  { name: m.post.home, href: localePath(locale, "/") },
  { name: categoryName, href: topicPath(locale, post.category) },
  { name: post.title },
];
const url = new URL(post.path, site).toString();
const jsonLd = graph([
  blogPostingNode(site, post, categoryName, alternates),
  breadcrumbNode(site, crumbs.map((c) => ({ name: c.name, path: c.href })), url),
  faqNode(post.faq),
  definedTermNode(site, post, new URL(topicPath(locale, post.category), site).toString(), categoryName),
]);
---

<BaseLayout
  locale={locale}
  title={pageTitle(locale, post.title)}
  description={post.description}
  path={`/posts/${post.slug}/`}
  alternates={alternates}
  type="article"
  keywords={[...post.tags, categoryName]}
  article={{ published: post.published, modified: post.modified, tags: post.tags, section: categoryName }}
  jsonLd={[jsonLd]}
  active="articles"
>
  <!-- 纯 Markdown 版本:大模型 / 答案引擎抓取用 -->
  <link slot="head" rel="alternate" type="text/markdown" href={url.replace(/\/$/, ".md")} />
  <article class="container post">
    <div class="cols">
      <div class="main">
        <header class="head">
          <Breadcrumbs locale={locale} items={crumbs} />
          <a class="badge" href={topicPath(locale, post.category)}>{categoryName}</a>
          <h1>{post.title}</h1>
          <p class="byline">
            <span>{m.post.by} <a class="author" href={localePath(locale, "/about/")} rel="author"><strong>{m.team}</strong></a></span>
            <span class="sep" aria-hidden="true">·</span>
            <span>{m.post.published} <time datetime={isoDate(post.published)}>{formatDate(post.published, locale)}</time></span>
            {
              post.showUpdated && (
                <>
                  <span class="sep" aria-hidden="true">·</span>
                  <span>{m.post.updated} <time datetime={isoDate(post.modified)}>{formatDate(post.modified, locale)}</time></span>
                </>
              )
            }
            <span class="sep" aria-hidden="true">·</span>
            <span class="read"><Icon name="clock" size={15} />{m.card.minRead(post.readingMinutes)}</span>
          </p>
        </header>

        <div class="hero-cover"><CoverArt category={post.category} iconSize={64} /></div>

        <aside class="short" data-geo-summary>
          <p class="short-label">{m.post.shortAnswer}</p>
          <p class="short-text">{post.description}</p>
        </aside>

        <TableOfContents headings={headings} title={m.post.onThisPage} variant="mobile" />

        <div class="prose" id="article-body">
          <Content />
        </div>

        <FaqList items={post.faq} title={m.post.faq} />

        <CtaCard locale={locale} placement={`post_${post.slug}`} />

        {
          (older || newer) && (
            <nav class:list={["neighbors", { single: !(older && newer) }]} aria-label={m.post.related}>
              {older ? (
                <a class="nb prev" href={older.path} rel="prev">
                  <span class="nb-label"><Icon name="arrow" size={16} class="arrow flip" />{m.post.previous}</span>
                  <span class="nb-title">{older.title}</span>
                </a>
              ) : <span />}
              {newer ? (
                <a class="nb next" href={newer.path} rel="next">
                  <span class="nb-label">{m.post.next}<Icon name="arrow" size={16} class="arrow" /></span>
                  <span class="nb-title">{newer.title}</span>
                </a>
              ) : <span />}
            </nav>
          )
        }
      </div>

      <aside class="side no-print">
        <TableOfContents headings={headings} title={m.post.onThisPage} variant="desktop" />
        <CtaCard locale={locale} variant="side" placement={`post_${post.slug}_side`} />
      </aside>
    </div>

    {
      related.length > 0 && (
        <section class="related" aria-labelledby="related-title">
          <h2 id="related-title">{m.post.related}</h2>
          <div class="related-grid">{related.map((p) => <PostCard post={p} headingLevel={3} />)}</div>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .post {
    padding-block-start: 2rem;
  }
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 44rem) 17rem;
    justify-content: center;
    gap: 4rem;
  }
  .main {
    min-inline-size: 0;
  }
  .head {
    display: grid;
    justify-items: start;
    gap: 1rem;
  }
  .badge {
    padding: 0.25rem 0.8rem;
    border-radius: 999px;
    background: var(--accent-soft);
    border: 1px solid var(--accent-soft-border);
    color: var(--link);
    font-size: 0.82rem;
    font-weight: 750;
    text-decoration: none;
  }
  h1 {
    color: var(--text);
    font-size: clamp(1.9rem, 4.4vw, 2.75rem);
    font-weight: 850;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }
  .byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.6rem;
    color: var(--text-muted);
    font-size: 0.92rem;
  }
  .byline strong {
    color: var(--text-soft);
  }
  .author {
    text-decoration: none;
  }
  .author:hover strong {
    color: var(--link);
    text-decoration: underline;
  }
  .read {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .sep {
    opacity: 0.5;
  }
  .hero-cover {
    margin-block-start: 1.75rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .hero-cover :global(.cover) {
    aspect-ratio: 21 / 8;
  }
  .short {
    margin-block-start: 1.75rem;
    padding: 1.15rem 1.35rem;
    border-inline-start: 4px solid var(--brand-600);
    border-radius: var(--radius);
    background: var(--accent-soft);
  }
  .short-label {
    color: var(--link);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .short-text {
    margin-block-start: 0.35rem;
    color: var(--text);
    font-size: 1.08rem;
    line-height: 1.65;
    font-weight: 550;
  }
  :global(.toc.mobile) {
    margin-block-start: 1.5rem;
  }
  .prose {
    margin-block-start: 1.75rem;
  }
  .side {
    position: sticky;
    inset-block-start: calc(var(--header-h) + 24px);
    align-self: start;
    display: grid;
    gap: 2rem;
  }
  .neighbors {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-block-start: 3rem;
  }
  .neighbors.single {
    grid-template-columns: 1fr;
  }
  .nb {
    display: grid;
    gap: 0.35rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .nb:hover {
    border-color: var(--accent-soft-border);
    box-shadow: var(--shadow-md);
  }
  .nb.next {
    text-align: end;
  }
  .nb-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-muted);
    font-size: 0.82rem;
    font-weight: 650;
  }
  .nb.next .nb-label {
    justify-content: flex-end;
  }
  .nb-title {
    color: var(--text);
    font-weight: 750;
    line-height: 1.35;
  }
  .related {
    margin-block-start: 4.5rem;
    padding-block-start: 3rem;
    border-block-start: 1px solid var(--border);
  }
  .related h2 {
    margin-block-end: 1.5rem;
    color: var(--text);
    font-size: 1.5rem;
    font-weight: 800;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18.5rem, 1fr));
    gap: 1.5rem;
  }

  @media (max-width: 1020px) {
    .cols {
      grid-template-columns: minmax(0, 44rem);
      gap: 0;
    }
    .side {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .neighbors {
      grid-template-columns: 1fr;
    }
    .hero-cover :global(.cover) {
      aspect-ratio: 16 / 7;
    }
  }
</style>
